{
  "manifest_version": 3,
  "name": "LinkLoom",
  "version": "1.2.0",
  "description": "Copy a cleaner link from the current page in one click. Preview removed trackers; signed links stay unchanged.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkLoom"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
